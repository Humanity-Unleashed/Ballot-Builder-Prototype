generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model FeedbackEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  screen     String
  screenName String   @map("screen_name")
  type       String?
  message    String
  email      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("feedback_entries")
}

model AnalyticsEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id")
  eventType  String   @map("event_type")
  screen     String
  screenName String   @map("screen_name")
  properties Json     @default("{}")
  referrer   String?
  duration   Int?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
  @@map("analytics_events")
}

model BallotCache {
  id           String   @id @default(cuid())
  districtHash String   @map("district_hash")
  electionDate String   @map("election_date")
  rawBallot    Json     @map("raw_ballot")
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@unique([districtHash, electionDate])
  @@index([districtHash])
  @@map("ballot_cache")
}

model VoterInfoCache {
  id                           String   @id @default(cuid())
  stateCode                    String   @unique @map("state_code")
  stateName                    String   @map("state_name")
  registrationDeadlineInPerson String?  @map("registration_deadline_in_person")
  registrationDeadlineByMail   String?  @map("registration_deadline_by_mail")
  registrationDeadlineOnline   String?  @map("registration_deadline_online")
  idRequirementsToVote         String?  @map("id_requirements_to_vote")
  idRequirementsToRegister     String?  @map("id_requirements_to_register")
  absenteeBallotRules          String?  @map("absentee_ballot_rules")
  earlyVotingStarts            String?  @map("early_voting_starts")
  earlyVotingEnds              String?  @map("early_voting_ends")
  electionDayRegistration      Boolean? @map("election_day_registration")
  automaticVoterRegistration   Boolean? @map("automatic_voter_registration")
  voterRegistrationUrl         String?  @map("voter_registration_url")
  absenteeBallotUrl            String?  @map("absentee_ballot_url")
  electionInformationUrl       String?  @map("election_information_url")
  pollingPlaceUrl              String?  @map("polling_place_url")
  fetchedAt                    DateTime @default(now()) @map("fetched_at")

  @@map("voter_info_cache")
}

model ZipcodeLookup {
  id             String   @id @default(cuid())
  zipcode        String   @unique
  state          String
  county         String?
  city           String?
  ocdDivisionIds Json     @map("ocd_division_ids")
  lat            Float?
  lng            Float?
  districtHash   String   @map("district_hash")
  fetchedAt      DateTime @default(now()) @map("fetched_at")

  @@map("zipcode_lookups")
}

// ── better-auth models ──────────────────────────

model User {
  id            String    @id
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  isAnonymous   Boolean?  @default(false) @map("is_anonymous")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id])

  @@map("accounts")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}
