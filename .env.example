# ============================================
# Ballot Builder - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to git - it contains secrets!

# --------------------------------------------
# Application Settings
# --------------------------------------------
NODE_ENV=development

# --------------------------------------------
# Authentication (better-auth)
# --------------------------------------------
# Secret key for signing sessions - CHANGE THIS IN PRODUCTION!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth - Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------
# AI/LLM API Keys (optional)
# --------------------------------------------
# Choose one or more based on your needs

# OpenAI API Key - Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude API Key - Get from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# --------------------------------------------
# External APIs (optional)
# --------------------------------------------
# Ballotpedia API - Contact data@ballotpedia.org for access
# BALLOTPEDIA_API_KEY=your-ballotpedia-api-key-here

# Google Civic API - Get from https://console.developers.google.com
# GOOGLE_CIVIC_API_KEY=your-google-civic-api-key-here

# --------------------------------------------
# DeepInfra (Conversational v2)
# --------------------------------------------
# Get API key from https://deepinfra.com/dash/api_keys
# DEEPINFRA_API_KEY=your-deepinfra-api-key-here
# DEEPINFRA_WHISPER_MODEL=openai/whisper-large-v3-turbo
# DEEPINFRA_LLM_MODEL=gpt-oss-120b

# --------------------------------------------
# Google Sheets (Feedback mirroring)
# --------------------------------------------
# Service account credentials for appending feedback to a Google Sheet.
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# and enable the Google Sheets API.
# GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-from-url

# --------------------------------------------
# Database (Vercel Postgres)
# --------------------------------------------
# Pooled connection string (used at runtime via Prisma)
# DATABASE_URL=postgres://...?pgbouncer=true&sslmode=require

# Direct connection string (used for migrations)
# DIRECT_URL=postgres://...?sslmode=require
